package(default_visibility = ["//visibility:public"])

# SignalEvent payload shared by SignalSourceNode (producer) and UiOverlayNode
# (consumer): packets are type-checked across nodes, so the type has one home.

cc_library(
    name = "signal_event",
    hdrs = ["signal_event.h"],
    visibility = ["//visibility:public"],
)

# SignalSourceNode (spec 002): graph_runtime source node emitting bypass
# SignalEvents (kTick) per Process.

cc_library(
    name = "signal_source",
    srcs = ["signal_source_node.cc"],
    hdrs = ["signal_source_node.h"],
    deps = [
        ":signal_event",
        "@graph_runtime//src/framework/public:runtime",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)
