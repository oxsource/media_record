package(default_visibility = ["//visibility:public"])

# Software bitmap-font timestamp renderer (spec 002, T012).
cc_library(
    name = "bitmap_font",
    srcs = ["bitmap_font.cc"],
    hdrs = ["bitmap_font.h"],
)

# UiOverlayNode (spec 002): flex-anchored real-clock timestamp drawn with the
# software bitmap font into the RGBA frame.
cc_library(
    name = "ui_overlay",
    srcs = ["ui_overlay_node.cc"],
    hdrs = ["ui_overlay_node.h"],
    deps = [
        ":bitmap_font",
        "//src/framework/public:media_record",
        "//src/framework/transport:transport",
        "@native_ui//:native_ui",
        "@video_codec//src/framework/public:video_codec",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)
