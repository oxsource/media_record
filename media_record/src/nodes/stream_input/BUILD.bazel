package(default_visibility = ["//visibility:public"])

# StreamInputNode (spec 002): graph_runtime source node that decodes the
# default image and emits one RGBA VideoFrame per Process with a real-clock
# timestamp. alwayslink keeps the GRAPH_RUNTIME_REGISTER_NODE static-init
# registration in binaries that only create nodes by name.

cc_library(
    name = "stream_input",
    srcs = ["stream_input_node.cc"],
    hdrs = ["stream_input_node.h"],
    deps = [
        "@graph_runtime//src/framework/public:runtime",
        "@native_ui//:native_ui",
        "@video_codec//src/framework/public:video_codec",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)
