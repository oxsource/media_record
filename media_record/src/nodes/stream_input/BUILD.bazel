package(default_visibility = ["//visibility:public"])

# StreamInputNode (spec 002): decodes the default image, emits one RGBA frame
# per Process with a real-clock timestamp. alwayslink keeps the REGISTER_NODE
# static-init registration in binaries that only create nodes by name.
cc_library(
    name = "stream_input",
    srcs = ["stream_input_node.cc"],
    hdrs = ["stream_input_node.h"],
    deps = [
        "//src/framework/public:media_record",
        "//src/framework/transport:transport",
        "@native_ui//:native_ui",
        "@video_codec//src/framework/public:video_codec",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)
