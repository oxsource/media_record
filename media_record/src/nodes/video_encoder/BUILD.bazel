package(default_visibility = ["//visibility:public"])

# Software RGBA->I420 converter (spec 002, T011). Uses libyuv ARGBToI420
# (SIMD/NEON on aarch64) — the scalar version cost ~52ms/frame at 1280x720 on
# device and dominated the CPU pipeline.
cc_library(
    name = "rgba_i420",
    srcs = ["rgba_i420.cc"],
    hdrs = ["rgba_i420.h"],
    deps = ["@libyuv//:libyuv"],
)

# VideoEncoderNode (spec 002): graph_runtime node; software RGBA->I420 +
# video_codec VideoEncoder (H.264, FFmpeg backend) in push mode; encoded
# packets are forwarded as graph::runtime::Packet on "output:es_packets".

cc_library(
    name = "video_encoder",
    srcs = ["video_encoder_node.cc"],
    hdrs = ["video_encoder_node.h"],
    deps = [
        ":rgba_i420",
        "//src/framework/lifecycle:lifecycle",
        "@graph_runtime//src/framework/public:runtime",
        "@video_codec//src/framework/public:video_codec",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)
