{
  "nodes": [
    {
      "name": "source",
      "type": "StreamInputNode",
      "options": {
        "image": "src/examples/assets/dashcam_default.png",
        "width": 1280,
        "height": 720,
        "fps": 30,
        "frame_count": 300
      },
      "output_streams": ["output:src_frames"]
    },
    {
      "name": "encoder",
      "type": "VideoEncoderNode",
      "options": {
        "fps": 30,
        "bitrate": 4000000
      },
      "input_streams": ["input:src_frames"],
      "output_streams": ["output:es_packets"]
    },
    {
      "name": "stream_sink",
      "type": "StreamSinkNode",
      "input_streams": ["input:es_packets"]
    }
  ]
}
