{
  "nodes": [
    {
      "name": "cam_front",
      "type": "StreamInputNode",
      "options": {
        "image": "src/examples/assets/dashcam_default.png",
        "width": 1280,
        "height": 720,
        "fps": 30,
        "frame_count": 300
      },
      "output_streams": ["output:front_frames"]
    },
    {
      "name": "cam_rear",
      "type": "StreamInputNode",
      "options": {
        "image": "src/examples/assets/dashcam_default.png",
        "width": 1280,
        "height": 720,
        "fps": 30,
        "frame_count": 300
      },
      "output_streams": ["output:rear_frames"]
    },
    {
      "name": "layout",
      "type": "MultiViewLayoutNode",
      "input_streams": ["f:front_frames", "r:rear_frames"],
      "output_streams": ["output:view_frames"]
    },
    {
      "name": "overlay",
      "type": "UiOverlayNode",
      "options": {
        "format": "%Y-%m-%d %H:%M:%S"
      },
      "input_streams": ["video:view_frames"],
      "output_streams": ["output:osd_frames"]
    },
    {
      "name": "encoder",
      "type": "VideoEncoderNode",
      "options": {
        "fps": 30,
        "bitrate": 4000000
      },
      "input_streams": ["input:osd_frames"],
      "output_streams": ["output:es_packets"]
    },
    {
      "name": "recorder",
      "type": "RecorderNode",
      "input_streams": ["input:es_packets"],
      "output_streams": ["output:clips"]
    },
    {
      "name": "muxer",
      "type": "MuxerSinkNode",
      "options": {
        "output": "out/recorder.mp4",
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "input_streams": ["input:clips"]
    }
  ]
}
