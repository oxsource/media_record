package(default_visibility = ["//visibility:public"])

# Minimal consumer (task T015 / US1): includes the public umbrella header and
# links the skeleton public library to verify it compiles standalone.
cc_binary(
    name = "consumer_demo",
    srcs = ["consumer_demo.cc"],
    deps = [
        "//:media_record",
    ],
)

# Dashcam recording entry (spec 002 / T020): loads dashcam_record.json
# (graph_runtime schema, node params in each node's "options" object) and runs
# the DashcamRenderNode pipeline (DashcamRender -> Encoder -> Recorder -> Muxer)
# for the default 10s @ 30fps -> out/dashcam_host_cpu.mp4. It drives graph_runtime's own
# async runtime inline (no runner module); CLI overrides (--output/--frames)
# use GraphRuntime::Options node-option injection. All node libraries are linked
# (alwayslink) so their GRAPH_RUNTIME_REGISTER_NODE registrations are present
# for NodeFactoryRegistry::CreateByName(type).
cc_binary(
    name = "dashcam_record",
    srcs = ["dashcam_record.cc"],
    data = [
        "//src/examples/assets:assets",
        "//src/examples/configs:configs",
    ] + select({
        # Android (spec 003): MediaCodec backend, no FFmpeg archive on device.
        "//platforms:android_arm64": [],
        # ADR-001: force-load FFmpeg on host (see video_codec backend BUILD).
        "//conditions:default": ["@ffmpeg//:ffmpeg_codec_archive"],
    }),
    linkopts = select({
        "//platforms:android_arm64": [],
        "//conditions:default": [
            "-Wl,-force_load,$(execpath @ffmpeg//:ffmpeg_codec_archive)",
        ],
    }),
    deps = [
        "//src/framework/lifecycle:lifecycle",
        "//src/nodes/dashcam_render:dashcam_render",
        "//src/nodes/muxer_sink:muxer_sink",
        "//src/nodes/recorder:recorder",
        "//src/nodes/video_encoder:video_encoder",
        "@graph_runtime//src/framework/public:runtime",
    ],
)

# Standalone debug entry for DashcamRenderer (no graph_runtime). Renders a few
# frames and dumps them to PNG via native::ui Surface::CreateFromPixels + Dump.
cc_binary(
    name = "render_demo",
    srcs = ["render_demo.cc"],
    data = ["//src/examples/assets:assets"],
    deps = [
        "//src/render:render",
        "@native_ui//:native_ui",
    ],
)
