# End-to-end recording test (spec 002, T021): runs the real 6-node graph_runtime
# pipeline with a short budget and asserts a playable MP4.
cc_test(
    name = "dashcam_record_test",
    size = "medium",
    srcs = ["dashcam_record_test.cc"],
    data = [
        "//src/examples/assets:assets",
        "//src/examples/configs:configs",
        "@ffmpeg//:ffmpeg_codec_archive",  # ADR-001
    ],
    linkopts = ["-Wl,-force_load,$(execpath @ffmpeg//:ffmpeg_codec_archive)"],
    # Force static linkage (ADR-001): avoids Bazel building @video_codec as a
    # shared solib dylib where the lazy-linked FFmpeg archive members are
    # dropped (avcodec_find_encoder crashes at runtime).
    linkstatic = True,
    deps = [
        "//src/nodes/multi_view_layout:multi_view_layout",
        "//src/nodes/muxer_sink:muxer_sink",
        "//src/nodes/recorder:recorder",
        "//src/nodes/stream_input:stream_input",
        "//src/nodes/ui_overlay:ui_overlay",
        "//src/nodes/video_encoder:video_encoder",
        "@com_google_googletest//:gtest_main",
        "@graph_runtime//src/framework/public:runtime",
        "@native_ui//:native_ui",
        "@video_codec//src/framework/public:video_codec",
    ],
)
