package(default_visibility = ["//visibility:public"])

cc_library(
    name = "skia",
    hdrs = glob(["include/**/*.h"]),
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = [
            "src/gpu/**/*.cpp",
            "src/android/**/*.cpp",
            "src/codec/**/*.cpp",
            "src/pdf/**/*.cpp",
            # Skia's own SVG backend + XML parser (needs expat, unavailable in the
            # Android NDK sysroot). This repo uses nanosvg instead, so both are omitted.
            "src/svg/**/*.cpp",
            "src/xml/**/*.cpp",
            # SkDebug_android.cpp is intentionally NOT excluded: Skia's config headers
            # auto-define SK_BUILD_FOR_ANDROID when __ANDROID__ is set, so the android
            # build needs the Android SkDebug implementation.
            "src/ports/SkDebug_win.cpp",
            "src/ports/SkFontConfigInterface*.cpp",
            "src/ports/SkFontMgr_android*.cpp",
            "src/ports/fontations/**/*.cpp",
            "src/ports/SkFontMgr_fontations*.cpp",
            "src/ports/SkFontMgr_fontconfig*.cpp",
            "src/ports/SkFontMgr_FontConfigInterface*.cpp",
            "src/ports/SkFontMgr_fuchsia.cpp",
            "src/ports/SkFontMgr_win_dw.cpp",
            "src/ports/SkFontScanner_fontations.cpp",
            "src/ports/SkImageEncoder_NDK.cpp",
            "src/ports/SkImageGeneratorNDK.cpp",
            "src/ports/SkImageGeneratorWIC.cpp",
            "src/ports/SkImageGenerator_skia.cpp",
            "src/ports/SkMemory_mozalloc.cpp",
            "src/ports/SkNDKConversions.cpp",
            "src/ports/SkOSFile_win.cpp",
            "src/ports/SkOSLibrary_win.cpp",
            "src/ports/SkScalerContext_win_dw.cpp",
            "src/ports/SkTypeface_fontations.cpp",
            "src/ports/SkTypeface_win_dw.cpp",
            "src/ports/SkImageGeneratorCG.cpp",
            "src/encode/SkJPEGWriteUtility.cpp",
            "src/encode/SkJpegEncoderImpl.cpp",
            "src/encode/SkWebpEncoderImpl.cpp",
            "src/encode/SkPngEncoderImpl.cpp",
            "src/encode/SkJpegGainmapEncoder.cpp",
            "src/sksl/lex/**/*.cpp",
        ],
    ) + [
        # skcms (modules, outside src/): color management used by SkColorSpace/SkRasterPipeline.
        "modules/skcms/skcms.cc",
        "modules/skcms/src/skcms_TransformBaseline.cc",
        "modules/skcms/src/skcms_TransformHsw.cc",
        "modules/skcms/src/skcms_TransformSkx.cc",
        # Codec chain required by ganesh's persistent shader cache (SkReadBuffer ->
        # SkImages::DeferredFromEncodedData). No decoder backends are enabled (SK_HAS_*),
        # so SkCodec::MakeFromData returns nullptr and no external image libs are linked.
        "src/codec/SkCodec.cpp",
        "src/codec/SkCodecImageGenerator.cpp",
        "src/codec/SkImageGenerator_FromEncoded.cpp",
        "src/codec/SkEncodedInfo.cpp",
        "src/codec/SkPixmapUtils.cpp",
        "src/codec/SkColorPalette.cpp",
        "src/codec/SkSampler.cpp",
    ],
    includes = [
        ".",
        "include",
        "include/core",
        "include/config",
        "include/encode",
        "include/effects",
        "include/pathops",
        "include/utils",
        "include/codec",
        "src",
        "src/base",
        "src/core",
        "src/shaders",
        "src/image",
        "src/effects",
        "src/text",
        "src/ports",
        "src/utils",
        "src/encode",
        "src/pathops",
        "src/sfnt",
        "src/sksl",
        "src/codec",
        "modules/skcms",
        "modules/skcms/src",
    ],
    copts = [
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    deps = ["@freetype//:freetype"],
    linkopts = select({
        "@native_ui//platforms:macos_arm64": [
            "-framework ApplicationServices",
            "-framework CoreGraphics",
            "-framework CoreText",
            "-framework Metal",
        ],
        "//conditions:default": [],
    }),
)

# Ganesh GPU backend (GLES/EGL, Android only). Compiled with SK_GANESH + SK_GL +
# SK_BUILD_FOR_ANDROID; the raster-only `skia` target above provides the core/sksl
# symbols this links against. Only built for the android_arm64 platform (see
# //src/framework/surface:surface which selects it), so host/CI builds stay on `skia`.
cc_library(
    name = "skia_gpu",
    hdrs = glob(["include/**/*.h"]),
    srcs = glob(
        ["src/gpu/**/*.cpp", "src/android/**/*.cpp"],
        exclude = [
            "src/gpu/graphite/**/*.cpp",
            "src/gpu/vk/**/*.cpp",
            "src/gpu/mtl/**/*.cpp",
            "src/gpu/d3d/**/*.cpp",
            "src/gpu/ganesh/vk/**/*.cpp",
            "src/gpu/ganesh/mtl/**/*.cpp",
            "src/gpu/ganesh/d3d/**/*.cpp",
            "src/gpu/ganesh/gl/iOS/**/*.cpp",
            "src/gpu/ganesh/gl/mac/**/*.cpp",
            "src/gpu/ganesh/gl/glfw/**/*.cpp",
            "src/gpu/ganesh/gl/glx/**/*.cpp",
            "src/gpu/ganesh/gl/epoxy/**/*.cpp",
            "src/gpu/ganesh/gl/egl/**/*.cpp",
            "src/gpu/ganesh/gl/GrGLMakeNativeInterface_none.cpp",
        ],
    ),
    includes = [
        ".",
        "include",
        "include/core",
        "include/config",
        "include/effects",
        "include/encode",
        "include/pathops",
        "include/utils",
        "include/gpu",
        "include/gpu/ganesh",
        "include/android",
        "src",
        "src/base",
        "src/core",
        "src/gpu",
        "src/gpu/ganesh",
        "src/gpu/ganesh/gl",
        "src/gpu/ganesh/glsl",
        "src/sksl",
        "src/utils",
        "src/ports",
    ],
    defines = [
        "SK_GANESH",
        "SK_GL",
        "SK_BUILD_FOR_ANDROID",
    ],
    copts = [
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    deps = [":skia"],
    linkopts = [
        "-lEGL",
        "-lGLESv3",
        "-landroid",
        "-llog",
    ],
)
