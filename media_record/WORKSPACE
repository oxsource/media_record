workspace(name = "media_record")

load("//:media_record_deps.bzl", "media_record_deps")

media_record_deps()

# --- Android NDK toolchain (spec 003, mirrors video_codec's WORKSPACE) -------
# rules_android_ndk provides the Android NDK cc_toolchain for cross-builds
# (--config android_arm64). The NDK path is resolved from the ANDROID_NDK_HOME
# environment variable; the repo is fetched lazily, so host (non-Android) builds
# never touch the NDK. Registered before media_record_setup() so native_ui's own
# rules_android_ndk http_archive is skipped (existing_rule guard).
load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rules_android_ndk",
    sha256 = "65aedff0cd728bee394f6fb8e65ba39c4c5efb11b29b766356922d4a74c623f5",
    strip_prefix = "rules_android_ndk-0.1.2",
    urls = ["https://github.com/bazelbuild/rules_android_ndk/releases/download/v0.1.2/rules_android_ndk-v0.1.2.tar.gz"],
)

load("@rules_android_ndk//:rules.bzl", "android_ndk_repository")

android_ndk_repository(name = "androidndk")

load("//:media_record_setup.bzl", "media_record_setup")

media_record_setup()

# --- video_codec transitive setup (mirrors video_codec's own WORKSPACE) ------
# video_codec builds FFmpeg from source via rules_foreign_cc. Its *_setup()
# function registers the rules_foreign_cc repo; the *_dependencies() call below
# (which registers rules_python and the foreign_cc toolchains) must run AFTER
# that repo exists, hence this second WORKSPACE phase.
load("@rules_foreign_cc//foreign_cc:repositories.bzl", "rules_foreign_cc_dependencies")

rules_foreign_cc_dependencies(
    register_built_tools = False,
    register_built_pkgconfig_toolchain = False,
)
